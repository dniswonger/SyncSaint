# Copy to .env.local for local dev. All of these are PUBLIC values (they end up in the JS bundle).
# Never put a client secret or private key here.
VITE_SPOTIFY_CLIENT_ID=
VITE_TIDAL_CLIENT_ID=
# From `npm run keygen` (SEAL_PUBLIC_KEY)
VITE_SEAL_PUBLIC_KEY=
# Shown to playlist owners so they know who to send their code to
VITE_ADMIN_NAME=
